{{- $.Scratch.Add "searchindex" slice -}}
{{- range $index, $element := where site.RegularPages "Params.indexable" "ne" false -}}
    {{- $.Scratch.Add "searchindex" (dict "id" $index "title" $element.Title "permalink" $element.RelPermalink "tags" (delimit ($element.Params.tags | default "") " ") "content" $element.Plain "summary" (partial "components/summary.html" $element) "date" (dateFormat ($.Param "dateformat" | default "2 January, 2006") $element.Date)) -}}
{{- end -}}
{{- $.Scratch.Get "searchindex" | jsonify -}}
